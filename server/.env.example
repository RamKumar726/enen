# Local development. Copy to server/.env and replace values as needed.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/enen_ecommerce

# Use distinct random values locally too. Example generation:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-random-secret-1
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-2
JWT_EXPIRE=15m

# Vite defaults to 5173. Keep only the origin(s) you actually use; no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

# Optional. Set true only if local MongoDB is a replica set (e.g. Atlas or local replica set).
MONGO_TRANSACTIONS=false

# Optional SMTP; needed for real password reset email delivery.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Optional Razorpay TEST credentials (never put live keys in local .env).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Needed only when testing Razorpay webhooks; use a separate webhook test secret.
RAZORPAY_WEBHOOK_SECRET=

# Optional Shiprocket API credentials. See notes: Shiprocket API calls affect your account.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_PACKAGE_LENGTH_CM=28
SHIPROCKET_PACKAGE_WIDTH_CM=22
SHIPROCKET_PACKAGE_HEIGHT_CM=3

# Optional local upload directory (no product image upload UI is currently wired).
UPLOADS_DIR=./uploads

# Optional first admin bootstrap when running the seed script.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Store

# Set only when intentionally replacing seed catalog/carousel data.
SEED_DESTRUCTIVE=false
